{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  // Rate limiting de /api/contact : 5 requêtes / 60 s par IP.
  // `namespace_id` est un entier choisi par toi, unique dans ton compte Cloudflare.
  // Si ce binding est absent, l'API retombe sur un limiteur en mémoire (moins fiable).
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
